{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    "module": "commonjs",
    "moduleResolution": "node"
  },
  "include": [
    "renderer/**/*.test.ts",
    "renderer/**/*.test.tsx",
    "renderer/**/__tests__/**/*.ts",
    "renderer/**/__tests__/**/*.tsx",
    "electron/**/__tests__/**/*.ts",
    "electron/**/*.test.ts",
    "scripts/**/*.test.ts"
  ]
}
