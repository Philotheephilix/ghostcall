{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "electron/**/*",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "renderer/**/*",
    "**/__tests__/**",
    "**/*.test.ts"
  ]
}
