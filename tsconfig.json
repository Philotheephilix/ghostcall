{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": ".",
    "paths": { "@/*": ["./renderer/*"] },
    "skipLibCheck": true
  },
  "include": ["electron/**/*", "renderer/**/*"],
  "exclude": ["node_modules", "dist"]
}
